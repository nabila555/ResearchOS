# ResearchOS configuration. Copy to `.env` (project root) and adjust.
# Every value is optional; the defaults run fully locally.

# --- General -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Storage -------------------------------------------------------------
# Relative paths are resolved from the project root.
DATA_DIR=data
# Leave empty for SQLite at DATA_DIR/database/researchos.db.
# Future option: postgresql+psycopg://user:pass@localhost:5432/researchos
DATABASE_URL=
MAX_UPLOAD_MB=50

# --- HTTP ----------------------------------------------------------------
# JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AI (local, free) ----------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=2
# Local generation on a CPU can be slow; raise this if long answers time out.
OLLAMA_GENERATION_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=8192

# --- Retrieval -----------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_CHARS=9000
RETRIEVAL_MIN_SIMILARITY=0.45
EMBED_BATCH_SIZE=16

# --- AI (optional, paid) -------------------------------------------------
# Never required. Leave blank to keep everything local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
